# Copy to backend/.env and fill in. Real environment variables take precedence over this file.
PORT=8080
NVIDIA_API_KEY=
# More keys for rotation (on 401/403 a key is sidelined 30 min, on 429 it rests, then the next key is used):
# NVIDIA_API_KEYS=nvapi-aaa,nvapi-bbb,nvapi-ccc      (comma-separated), and/or
# NVIDIA_API_KEY_2=nvapi-bbb
# NVIDIA_API_KEY_3=nvapi-ccc
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_CHAT_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NIM_FALLBACK_MODELS=openai/gpt-oss-20b,meta/llama-3.2-11b-vision-instruct
NIM_VERIFY_MODEL=openai/gpt-oss-20b
NIM_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NIM_VISION_FALLBACK_MODELS=meta/llama-3.2-11b-vision-instruct
# JWT_SECRET=   (optional; generated once and stored in DATA_DIR/jwt-secret.txt when absent)
DATA_DIR=./data
# MONGODB_URI=mongodb+srv://user:pass@cluster/masteria   (optional; JSON file store is used when absent)
TIMEZONE=Asia/Kolkata
# CONTENT_DIR=../content   (optional; read content from disk instead of the classpath)
# FIREBASE_PROJECT_ID=your-firebase-project-id   (enables POST /auth/firebase; only the public project id is needed)
# TRUST_PROXY=true            (auto-on when RENDER is set; uses X-Forwarded-For for rate limiting)
# AUTH_RATE_LIMIT_PER_MINUTE=30
# KEEP_ALIVE=true             (on Render: self-ping RENDER_EXTERNAL_URL/health so the free plan doesn't sleep)
# KEEP_ALIVE_URL=https://masteria-backend.onrender.com   (explicit URL instead of RENDER_EXTERNAL_URL)
# KEEP_ALIVE_MINUTES=5
